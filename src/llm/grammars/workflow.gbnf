# GBNF Grammar for Workflow JSON
# Forces the LLM to generate valid JSON structure

root ::= workflow

workflow ::= "{" ws "\"workflow\"" ws ":" ws workflow-obj ws "}"

workflow-obj ::= "{" ws
  "\"id\"" ws ":" ws string ws "," ws
  "\"trigger\"" ws ":" ws trigger ws "," ws
  "\"steps\"" ws ":" ws steps ws
"}"

trigger ::= "{" ws
  "\"platform\"" ws ":" ws string ws "," ws
  "\"event\"" ws ":" ws string ws
"}"

steps ::= "[" ws "]" | "[" ws step (ws "," ws step)* ws "]"

step ::= simple-step | delay-step | conditional-step

simple-step ::= "{" ws
  "\"id\"" ws ":" ws string ws "," ws
  "\"type\"" ws ":" ws string ws "," ws
  "\"params\"" ws ":" ws object ws
  (ws "," ws "\"dependsOn\"" ws ":" ws string-array)?
"}"

delay-step ::= "{" ws
  "\"id\"" ws ":" ws string ws "," ws
  "\"type\"" ws ":" ws "\"delay\"" ws "," ws
  "\"duration\"" ws ":" ws number ws
  (ws "," ws "\"dependsOn\"" ws ":" ws string-array)?
"}"

conditional-step ::= "{" ws
  "\"id\"" ws ":" ws string ws "," ws
  "\"type\"" ws ":" ws "\"conditional\"" ws "," ws
  "\"condition\"" ws ":" ws object ws "," ws
  "\"onTrue\"" ws ":" ws steps ws "," ws
  "\"onFalse\"" ws ":" ws steps ws
  (ws "," ws "\"dependsOn\"" ws ":" ws string-array)?
"}"

object ::= "{" ws "}" | "{" ws pair (ws "," ws pair)* ws "}"

pair ::= string ws ":" ws value

value ::= string | number | boolean | "null" | object | array

array ::= "[" ws "]" | "[" ws value (ws "," ws value)* ws "]"

string-array ::= "[" ws "]" | "[" ws string (ws "," ws string)* ws "]"

string ::= "\"" ([^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""

number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [-+]? [0-9]+)?

boolean ::= "true" | "false"

ws ::= [ \t\n\r]*
