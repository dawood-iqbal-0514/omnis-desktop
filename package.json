{
  "name": "@omnis-reach/desktop",
  "version": "1.0.0",
  "description": "Omnis Reach Desktop Application",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run electron:dev\"",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run electron:build",
    "build:renderer": "vite build",
    "start": "electron .",
    "electron:dev": "wait-on http://localhost:5173 && electron .",
    "electron:build": "electron-builder",
    "electron:publish": "electron-builder --publish always"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^17.2.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "formik": "^2.4.9",
    "jsonrepair": "^3.13.2",
    "node-machine-id": "^1.1.12",
    "react-confetti": "^6.4.0",
    "react-hot-toast": "^2.6.0",
    "react-select": "^5.10.2",
    "yup": "^1.7.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "immer": "^10.0.3",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  }
}
